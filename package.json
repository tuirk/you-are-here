{
  "name": "you-are-here",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A reflective journal that turns how your days felt into a space you can move through. Write or speak an entry, and AI reads the sentiment and how long it lasted, turning it into coloured dust on a 3D spiral of your days, so you can see a moment in its place next to everything else.",
  "license": "MIT",
  "author": "tuirk",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuirk/you-are-here.git"
  },
  "homepage": "https://github.com/tuirk/you-are-here#readme",
  "bugs": {
    "url": "https://github.com/tuirk/you-are-here/issues"
  },
  "keywords": [
    "journal",
    "diary",
    "journaling",
    "mindfulness",
    "self-reflection",
    "mood-tracker",
    "mood-journal",
    "emotions",
    "mental-health",
    "wellbeing",
    "self-awareness",
    "sentiment-analysis",
    "generative-ai",
    "gemini",
    "data-visualization",
    "creative-coding"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@react-three/drei": "^9.80.1",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@types/three": "^0.154.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "postprocessing": "^6.35.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.154.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.5.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.2",
    "vitest": "^5.0.1"
  }
}
